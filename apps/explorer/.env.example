# denckring explorer — copy to .env and fill in.
#
#     cp apps/explorer/.env.example apps/explorer/.env
#
# .env is gitignored. Nothing here belongs in the repository, and nothing here
# is read by the `denckring` package — these configure the explorer only, which
# is a development tool that is never published.


# ── Corpora ────────────────────────────────────────────────────────────────
#
# Directory the corpus picker reads, on the ideenwuerfeln bench. Every *.json
# in it that the library's own parser can read is offered; the files stay where
# they are and nothing is copied.
#
# A corpus belongs to whoever assembled it (ADR 0020), so keep this pointed
# somewhere outside the repository. The Jean Paul excerpts built from the
# Würzburg digital edition are private, non-commercial use only and must not be
# committed or redistributed.
#
# Defaults to ~/corpora when unset, which is what this line shows: a real path
# from whoever last edited it is a path nobody else has, and the one committed
# here pointed at a home directory that does not exist on this machine — so the
# picker came up empty and the scene looked broken rather than unconfigured.
DENCKRING_CORPORA=~/corpora


# ── Finding the Witz ───────────────────────────────────────────────────────
#
# Enables the "Find the Witz" button under a generated throw: a model reads the
# collision and says what, if anything, the excerpts share.
#
# This is a reading, not a verdict. It produces no Report, nothing in the
# package depends on it, and no checker consults it — `ideenwuerfeln` says
# plainly that the Witz is the step no program does, and that stays true.
# Leave this unset and the button simply does not appear.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# The model asked for the reading. Defaults to claude-opus-5.
# DENCKRING_WITZ_MODEL=claude-opus-5


# ── Serving ────────────────────────────────────────────────────────────────
#
# The CLI flags --port, --host and --reload override these.
# EXPLORER_PORT=8412
# EXPLORER_HOST=127.0.0.1
